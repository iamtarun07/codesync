# These are read by Vite at BUILD time and inlined into the bundle, so they must
# be set on whatever machine or platform runs `npm run build`.
#
# Never put secrets here: everything prefixed VITE_ ships to the browser.
# MONGODB_URI and JWT_SECRET belong in server/.env only.

# Backend REST base URL (must include /api)
#   local:      http://localhost:5000/api
#   production: https://your-backend.example.com/api
VITE_API_URL=http://localhost:5000/api

# Socket.IO origin (no /api suffix — Socket.IO attaches at the server root)
#   local:      http://localhost:5000
#   production: https://your-backend.example.com
VITE_SOCKET_URL=http://localhost:5000

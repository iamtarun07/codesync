# ---- Server configuration -------------------------------------------------
# PORT is supplied by most deployment platforms — do not hardcode it there.
PORT=5000
# development | production | test
NODE_ENV=development

# ---- YOU MUST PROVIDE THIS ------------------------------------------------
# MongoDB connection string. Local example:
#   mongodb://127.0.0.1:27017/codesync
# Atlas: copy the driver string, then append the database name before the query
# string, and percent-encode any special characters in the password:
#   mongodb+srv://USER:PASSWORD@CLUSTER.xxxxx.mongodb.net/codesync?retryWrites=true&w=majority
# In production the server refuses to start if this points at localhost.
MONGODB_URI=YOUR_MONGODB_CONNECTION_STRING

# ---- YOU MUST PROVIDE THIS ------------------------------------------------
# Minimum 16 characters (32+ enforced in production). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=YOUR_LONG_RANDOM_SECRET

# Token lifetime (zeit/ms format: 15m, 12h, 7d ...)
JWT_EXPIRES_IN=7d

# The ONLY origin allowed by CORS and the Socket.IO handshake, and the origin the
# auth cookie is issued for. Must match the frontend exactly, no trailing slash.
# In production it must be an https:// URL and must not be localhost.
CLIENT_URL=http://localhost:5173

# ---- Optional: destructive test database ----------------------------------
# `npm test` drops the `codesync_test` database. It refuses to run when
# MONGODB_URI is not local unless this points at a throwaway instance.
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/codesync

# ---- Code execution (the Run button) --------------------------------------
# local    = run the code as a child process on this machine. Zero setup, uses
#            whatever runtimes you have installed. This is arbitrary code
#            execution on the host, so it is REFUSED when NODE_ENV=production
#            (the Run button reports that execution is disabled).
# piston   = POST to a Piston sandbox (set PISTON_URL). Use this if you deploy.
#            The free public instance became whitelist-only in Feb 2026, so
#            self-host: https://github.com/engineer-man/piston
# disabled = turn the feature off.
RUNNER=local
PISTON_URL=https://emkc.org/api/v2/piston
